# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
ALLOWED_EMAILS=igam0000@gmail.com

# Resend (Magic Link)
RESEND_API_KEY=re_xxxxx

# Relay
RELAY_API_KEY=your-relay-api-key-for-gateway
RELAY_URL=https://your-app.up.railway.app
DASHBOARD_URL=https://your-app.up.railway.app

# Database (Local PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/life_dashboard

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload / Storage
UPLOAD_MAX_SIZE=10485760
STORAGE_TYPE=local
# S3-compatible storage (when STORAGE_TYPE=s3)
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Cron Scheduler
CRON_SCHEDULER_INTERVAL_MS=60000
CRON_FAILURE_ALERT_THRESHOLD=3
CRON_ALERT_EMAIL=

# SEO Tracker (Cron Job)
GOOGLE_SEARCH_CONSOLE_KEY=
SERP_API_KEY=
SEO_TRACKER_ENABLED=true

# Codex fallback (Gateway Connector)
CODEX_BIN=codex
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL=never

# Model Routing (Token Optimization)
DISABLE_MODEL_ROUTING=false
ENABLE_TOKEN_TRACKING=true
DEFAULT_ECOMODE=false
GLOBAL_MODEL_CAP=
BASE_STALE_TIMEOUT=300000

# SSE Real-time Monitoring
# Heartbeat interval for SSE connections (ms)
SSE_HEARTBEAT_INTERVAL_MS=30000
# Maximum concurrent SSE connections
SSE_MAX_CONNECTIONS=10000
# Metrics collection enabled
SSE_METRICS_ENABLED=true

# Docker & Deployment
ENABLE_TMUX=false
NODE_ENV=development
PORT=3000
