# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this
ALLOWED_EMAILS=igam0000@gmail.com

# Resend (Magic Link)
RESEND_API_KEY=re_xxxxx

# Relay
RELAY_API_KEY=your-relay-api-key-for-gateway
RELAY_URL=https://your-app.up.railway.app
DASHBOARD_URL=https://your-app.up.railway.app

# Database (Local PostgreSQL)
DATABASE_URL=postgresql://localhost:5432/life_dashboard

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# File Upload / Storage
UPLOAD_MAX_SIZE=10485760
STORAGE_TYPE=local
# S3-compatible storage (when STORAGE_TYPE=s3)
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# Cron Scheduler
CRON_SCHEDULER_INTERVAL_MS=60000
CRON_FAILURE_ALERT_THRESHOLD=3
CRON_ALERT_EMAIL=

# Codex fallback (Gateway Connector)
CODEX_BIN=codex
CODEX_MODEL=
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL=never
